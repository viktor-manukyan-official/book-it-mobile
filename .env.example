# BookIt mobile — environment variables
#
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app at build/runtime.
# These are PUBLIC by definition (shipped in the app bundle) — never put secrets here.
#
# Firebase config for the mobile app does NOT live here. @react-native-firebase
# reads the PUBLIC native config files instead (referenced in app.json):
#   ./google-services.json        (Android)
#   ./GoogleService-Info.plist    (iOS)
# Download those from the Firebase console (Project settings > your apps).
#
# The firebase-admin service-account key (FIREBASE_PRIVATE_KEY, etc.) is a
# BACKEND-ONLY secret and must NEVER be added to this mobile repo.

# Backend GraphQL API base URL (the app appends /graphql).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
